# URL de l'API.
# "/api"  = passe par le proxy de Vite vers le serveur (recommandé : marche aussi depuis un téléphone)
# Ou une URL complète, ex. http://localhost:5000/api (alors le serveur doit autoriser CORS)
VITE_API_URL=/api

# Cible du proxy Vite en développement (serveur Express)
VITE_PROXY_TARGET=http://localhost:5000
