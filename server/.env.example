# Port de l'API (le client attend http://localhost:5000/api)
PORT=5000

# Secrets : à changer. Le QR_SECRET doit être IDENTIQUE partout où l'on vérifie des billets.
JWT_SECRET=dev-jwt-secret-change-me
QR_SECRET=dev-qr-secret-change-me
JWT_EXPIRES=7d

# Fuseau horaire utilisé pour le filtre "date" des trajets
APP_TZ=Africa/Tunis

# Origines autorisées (séparées par des virgules). * = toutes (OK en développement)
CORS_ORIGIN=*

# Fichier de la fausse base de données JSON
DB_FILE=./data/db.json
